# ============================================================
# 通道 A：企业微信自建应用
# （管理后台 → 应用管理 → 你的应用 → 接收消息 → 设置API接收）
# 不打算用企业微信的话，这一整段可以留空或删掉
# ============================================================
# 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx

# 下面两个在「设置API接收」页面点「随机获取」生成，填什么就抄什么
# Token：自己定，3~32 位字母数字
WECOM_TOKEN=replace_me_with_your_token
# EncodingAESKey：固定 43 位，必须一字不差
WECOM_AES_KEY=replace_me_with_43_chars_encoding_aes_key

# ============================================================
# 通道 B：微信公众号 / 微信测试号
# （mp.weixin.qq.com → 设置与开发 → 基本配置 / 测试号管理页）
# 想直接在微信里用就配这一段，两套可以同时配，程序自动分流
# ============================================================
# 公众号 AppID（wx 开头）；测试号在管理页顶部直接能看到
WECHAT_APP_ID=wxxxxxxxxxxxxxxxxx
# 服务器配置里自己填的 Token，3~32 位字母数字
WECHAT_TOKEN=replace_me_with_your_token
# EncodingAESKey：43 位。用「安全模式」必填；「明文模式」可以留空
WECHAT_AES_KEY=
# auto = 按请求自动判断；也可写 safe / plain 强制指定
WECHAT_MODE=auto

# ============================================================
# 飞书多维表格（open.feishu.cn 开发者后台 → 创建企业自建应用）
# ============================================================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 多维表格链接里 /base/ 后面那一段
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxx
# 表格链接里 table= 后面那一段
FEISHU_TABLE_ID=tblxxxxxxxxxxxxxx

# 字段名（你表里叫什么就写什么，默认就是这几个中文名）
FEISHU_FIELD_AMOUNT=金额
FEISHU_FIELD_TYPE=类型
FEISHU_FIELD_NOTE=备注
FEISHU_FIELD_CATEGORY=分类
FEISHU_FIELD_DATE=日期
FEISHU_TYPE_EXPENSE=支出
FEISHU_TYPE_INCOME=收入

# ============================================================
# 行为配置（一般不用改）
# ============================================================
APP_TZ_OFFSET=8
# 回执里是否带「今日/本月」合计；设 0 可让回复更快
APP_SHOW_TODAY_TOTAL=1
# 查飞书的超时（毫秒）。跨云链路单次 1.5~3 秒很常见，别设太小
APP_FEISHU_TIMEOUT_MS=3800
# 「今日合计」单独的时间预算（毫秒）。记账成功后合计超时就不显示，绝不拖慢回执
APP_STATS_BUDGET_MS=1500
# 记账后顺手查一眼「90 秒内一模一样的记录」（复用算合计的那次查询，不额外花时间）
APP_DEDUPE_CHECK=1
# 数据落地：feishu | json | memory
APP_STORE=feishu
APP_JSON_FILE=./data/ledger.json
